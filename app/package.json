{
  "name": "moto-gear-app",
  "version": "2.0.0",
  "description": "Gestão de oficina de motos — estoque, serviços, caixa, clientes e OS. Offline-first, Android via Capacitor.",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/app.css -o www/css/app.css --minify",
    "serve": "python3 -m http.server 8791 --directory www",
    "test": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/barcode-scanner": "^2.0.0",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.49.0",
    "tailwindcss": "^3.4.0"
  }
}
